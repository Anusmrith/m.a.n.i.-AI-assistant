# J.A.R.V.I.S. Configuration

# Wake word identifier
JARVIS_NAME=Jarvis

# Neural Voice (Microsoft Edge TTS Neural Voices)
# Options: en-GB-RyanNeural (Authentic British JARVIS), en-GB-ThomasNeural, en-US-GuyNeural
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=+0Hz

# Microphone Energy Threshold (higher = less sensitive, lower = more sensitive)
ENERGY_THRESHOLD=400

# Server Network Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# (Optional) Google Gemini API Key for limitless AI reasoning & conversation
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# (Optional) Local Ollama Endpoint (if running Ollama locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
